					</td>
					<td>
						Hat
					</td>
					<td>
						間接対応
					</td>
				</tr>
				<tr>
					<td>
						イベント
					</td>
					<td>
						<code>
							[タイマー / 音量]
						</code>
						 がしきい値を超えたとき
